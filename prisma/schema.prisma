  fromStaff      Staff?   @relation("SubAgentAssignmentFromStaff", fields: [fromStaffId], references: [id], onDelete: SetNull)
  toStaff        Staff?   @relation("SubAgentAssignmentToStaff", fields: [toStaffId], references: [id], onDelete: SetNull)
  changedByUser  User?    @relation("SubAgentAssignmentChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByStaff Staff?   @relation("SubAgentAssignmentChangedByStaff", fields: [changedByStaffId], references: [id], onDelete: SetNull)

