  fromStaff Staff? @relation("EnquiryAssignmentFromStaff", fields: [fromStaffId], references: [id], onDelete: SetNull)
  toStaff   Staff? @relation("EnquiryAssignmentToStaff", fields: [toStaffId], references: [id], onDelete: SetNull)

  fromSupervisor Staff? @relation("EnquiryAssignmentFromSupervisor", fields: [fromSupervisorId], references: [id], onDelete: SetNull)
  toSupervisor   Staff? @relation("EnquiryAssignmentToSupervisor", fields: [toSupervisorId], references: [id], onDelete: SetNull)

  fromSubAgent SubAgent? @relation("EnquiryAssignmentFromSubAgent", fields: [fromSubAgentId], references: [id], onDelete: SetNull)
  toSubAgent   SubAgent? @relation("EnquiryAssignmentToSubAgent", fields: [toSubAgentId], references: [id], onDelete: SetNull)

  changedByUser  User?  @relation("EnquiryAssignmentChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByStaff Staff? @relation("EnquiryAssignmentChangedByStaff", fields: [changedByStaffId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([ownerUserId])
  @@index([fromStaffId])
  @@index([toStaffId])
  @@index([fromSupervisorId])
  @@index([toSupervisorId])
  @@index([fromSubAgentId])
  @@index([toSubAgentId])
  @@index([changedByUserId])
  @@index([changedByStaffId])
  @@index([enquiryId, createdAt])
  @@index([ownerUserId, createdAt])
}

model AgentSupervisorHistory {
