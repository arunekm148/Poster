model EnquiryAssignmentHistory {
  id          String @id @default(cuid())
  enquiryId   String
  ownerUserId String

  fromStaffId String?
  toStaffId   String?

  fromSupervisorId String?
  toSupervisorId   String?

  fromSubAgentId String?
  toSubAgentId   String?

