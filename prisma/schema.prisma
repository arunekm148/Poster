  randomizeQuestions Boolean            @default(true)
  randomizeOptions   Boolean            @default(false)
  isActive           Boolean            @default(true)
  isPublished        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attempts           ExamAttempt[]
  chapter            ExamChapter?       @relation(fields: [chapterId], references: [id])
  exam               Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  module             ExamModule?        @relation(fields: [moduleId], references: [id])
  questions          ExamTestQuestion[]

  @@unique([examId, code])
  @@index([examId])
  @@index([moduleId])
  @@index([chapterId])
  @@index([type])
  @@index([examId, isActive, isPublished])
