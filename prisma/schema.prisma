  languageId      String?
  mode            ExamAttemptMode
  status          ExamAttemptStatus   @default(IN_PROGRESS)
  totalQuestions  Int                 @default(0)
  correctCount    Int                 @default(0)
  wrongCount      Int                 @default(0)
  unansweredCount Int                 @default(0)
  score           Decimal?            @db.Decimal(10, 2)
  percentage      Decimal?            @db.Decimal(5, 2)
  passed          Boolean?
  startedAt       DateTime            @default(now())
  submittedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  exam            Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  language        ExamLanguage?       @relation(fields: [languageId], references: [id])
  test            ExamTest?           @relation(fields: [testId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         ExamAttemptAnswer[]

  @@index([userId])
  @@index([examId])
  @@index([testId])
  @@index([languageId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId, examId, createdAt])
}

model ExamAttemptAnswer {
