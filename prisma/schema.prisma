  testLinks     ExamTestQuestion[]

  @@unique([examId, code])
  @@index([examId])
  @@index([moduleId])
  @@index([chapterId])
  @@index([examId, isActive, isPublished])
  @@index([moduleId, isActive, isPublished])
  @@index([chapterId, isActive, isPublished])
}

model ExamQuestionTranslation {
