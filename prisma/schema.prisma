generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                     @id @default(cuid())
  name                     String
  phone                    String                     @unique
  email                    String?                    @unique
  password                 String
  role                     UserRole                   @default(AGENT)
  accountMode              AgentAccountMode           @default(SELF_STAFF)
  supervisorId             String?
  logoUrl                  String?
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  address                  String?
  district                 String?
  pincode                  String?
  state                    String?
  announcementsCreated     AdminAnnouncement[]        @relation("AnnouncementCreatedBy")
  bankAccount              AgentBankAccount?
  creditAccount            AgentCreditAccount?
  AttendanceHoliday        AttendanceHoliday[]
  AttendanceRegularization AttendanceRegularization[]
  AttendanceSetting        AttendanceSetting?
  consultants              Consultant[]
  creditTransactions       CreditTransaction[]
  customers                Customer[]
  downloads                Download[]
  emiFollowUps             EmiFollowUp[]
  enquiries                Enquiry[]
  examsCreated             Exam[]                     @relation("ExamCreatedBy")
  examAttempts             ExamAttempt[]
  examBookmarks            ExamBookmark[]
  followUps                FollowUp[]
  LeaveRequest             LeaveRequest[]
  mediaApprovals           Media[]                    @relation("MediaApprovedBy")
  mediaUploads             Media[]                    @relation("MediaUploadedBy")
  mediaRatings             MediaRating[]
  passwordResetOtps        PasswordResetOtp[]
  policies                 Policy[]
  renewalFollowUps         RenewalFollowUp[]
  staffs                   Staff[]
  offices                  Office[]
  StaffAttendance          StaffAttendance[]
  subAgents                SubAgent[]
  supportReplies           SupportMessage[]           @relation("SupportMessageAdmin")
  supportMessages          SupportMessage[]           @relation("SupportMessageAgent")
  companies                UserCompany[]
  withdrawalRequests       WithdrawalRequest[]        @relation("AgentWithdrawals")
  withdrawalsApproved      WithdrawalRequest[]        @relation("WithdrawalApprovedBy")

  // Hierarchy / assignment foundation
  supervisor                Staff?                      @relation("AgentSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  agentSupervisorHistory    AgentSupervisorHistory[]    @relation("AgentSupervisorHistoryAgent")
  supervisorChangesMade     AgentSupervisorHistory[]    @relation("AgentSupervisorHistoryChangedByUser")
  subAgentAssignmentHistory SubAgentAssignmentHistory[]
  subAgentChangesMade       SubAgentAssignmentHistory[] @relation("SubAgentAssignmentChangedByUser")
  enquiryAssignmentHistory  EnquiryAssignmentHistory[]
  enquiryChangesMade        EnquiryAssignmentHistory[]  @relation("EnquiryAssignmentChangedByUser")

  @@index([supervisorId])
}

model Company {
  id         String              @id @default(cuid())
  name       String
  logoUrl    String?
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  categories InsuranceCategory[] @default([])
  media      Media[]
  policies   Policy[]
  users      UserCompany[]

  @@index([isActive])
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  agentCode String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model SubAgent {
  id              String     @id @default(cuid())
  userId          String
  code            String
  name            String
  phone           String?
  whatsapp        String?
  email           String?
  address         String?
  district        String?
  state           String?
  pincode         String?
  notes           String?
  isActive        Boolean    @default(true)
  inactiveReason  String?
  inactiveAt      DateTime?
  assignedStaffId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  customers       Customer[]
  policies        Policy[]
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current assignment + permanent assignment history
  assignedStaff          Staff?                      @relation("SubAgentAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignmentHistory      SubAgentAssignmentHistory[] @relation("SubAgentAssignmentHistorySubAgent")
  enquiryAssignments     Enquiry[]                   @relation("EnquiryAssignedSubAgent")
  enquiryOrigins         Enquiry[]                   @relation("EnquiryOriginSubAgent")
  enquiryAssignmentsFrom EnquiryAssignmentHistory[]  @relation("EnquiryAssignmentFromSubAgent")
  enquiryAssignmentsTo   EnquiryAssignmentHistory[]  @relation("EnquiryAssignmentToSubAgent")

  @@unique([userId, code])
  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, name])
  @@index([phone])
  @@index([assignedStaffId])
  @@index([userId, assignedStaffId])
}

model Consultant {
  id             String    @id @default(cuid())
  userId         String
  code           String
  name           String
  contactPerson  String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  district       String?
  state          String?
  pincode        String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean   @default(true)
  inactiveReason String?
  inactiveAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  policies       Policy[]

  @@unique([userId, code])
  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, name])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media     Media[]
}

model Media {
  id                 String              @id @default(cuid())
  title              String
  type               MediaType           @default(IMAGE)
  fileUrl            String
  thumbnailUrl       String?
  companyId          String?
  categoryId         String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  approvalStatus     MediaApprovalStatus @default(APPROVED)
  approvedAt         DateTime?
  approvedByUserId   String?
  rejectionReason    String?
  source             MediaSource         @default(ADMIN)
  uploadedByUserId   String?
  creditAmount       Decimal?            @db.Decimal(14, 2)
  creditedAt         DateTime?
  creditTransactions CreditTransaction[]
  downloads          Download[]
  approvedBy         User?               @relation("MediaApprovedBy", fields: [approvedByUserId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company            Company?            @relation(fields: [companyId], references: [id])
  uploadedBy         User?               @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id])
  ratings            MediaRating[]

  @@index([companyId])
  @@index([categoryId])
  @@index([uploadedByUserId])
  @@index([approvedByUserId])
  @@index([isActive])
  @@index([source])
  @@index([approvalStatus])
  @@index([companyId, categoryId])
  @@index([approvalStatus, isActive])
  @@index([source, approvalStatus])
  @@index([uploadedByUserId, approvalStatus])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mediaId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([mediaId, createdAt])
}

model MediaRating {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([mediaId])
  @@index([mediaId, rating])
  @@index([createdAt])
}

model Customer {
  id               String            @id @default(cuid())
  userId           String
  name             String
  phone            String
  email            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  district         String?
  state            String?
  pincode          String?
  notes            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customerId       String            @unique
  inactiveAt       DateTime?
  inactiveReason   String?
  sourceType       CustomerSource    @default(SELF)
  subAgentId       String?
  subAgent         SubAgent?         @relation(fields: [subAgentId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  emiFollowUps     EmiFollowUp[]
  enquiries        Enquiry[]
  followUps        FollowUp[]
  policies         Policy[]
  renewalFollowUps RenewalFollowUp[]

  @@index([userId])
  @@index([phone])
  @@index([subAgentId])
  @@index([userId, phone])
  @@index([userId, sourceType])
  @@index([userId, subAgentId])
  @@index([userId, isActive])
  @@index([userId, createdAt])
  @@index([userId, isActive, createdAt])
}

model Enquiry {
  id               String        @id @default(cuid())
  userId           String
  customerId       String
  businessType     BusinessType
  requirement      String?
  remarks          String?
  status           EnquiryStatus @default(NEW)
  enquiryDate      DateTime      @default(now())
  nextFollowUpDate DateTime?
  convertedAt      DateTime?
  closedAt         DateTime?
  isActive         Boolean       @default(true)

  // Historical origin: never rewrite these when the enquiry is reassigned.
  originStaffId      String?
  originSupervisorId String?
  originSubAgentId   String?

  // Current working assignment: Agent direct when all three are null.
  assignedStaffId      String?
  assignedSupervisorId String?
  assignedSubAgentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUps FollowUp[]

  originStaff      Staff?    @relation("EnquiryOriginStaff", fields: [originStaffId], references: [id], onDelete: SetNull)
  originSupervisor Staff?    @relation("EnquiryOriginSupervisor", fields: [originSupervisorId], references: [id], onDelete: SetNull)
  originSubAgent   SubAgent? @relation("EnquiryOriginSubAgent", fields: [originSubAgentId], references: [id], onDelete: SetNull)

  assignedStaff      Staff?    @relation("EnquiryAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedSupervisor Staff?    @relation("EnquiryAssignedSupervisor", fields: [assignedSupervisorId], references: [id], onDelete: SetNull)
  assignedSubAgent   SubAgent? @relation("EnquiryAssignedSubAgent", fields: [assignedSubAgentId], references: [id], onDelete: SetNull)

  assignmentHistory EnquiryAssignmentHistory[] @relation("EnquiryAssignmentHistoryEnquiry")

  @@index([userId])
  @@index([customerId])
  @@index([originStaffId])
  @@index([originSupervisorId])
  @@index([originSubAgentId])
  @@index([assignedStaffId])
  @@index([assignedSupervisorId])
  @@index([assignedSubAgentId])
  @@index([userId, assignedStaffId])
  @@index([userId, assignedSupervisorId])
  @@index([userId, assignedSubAgentId])
  @@index([userId, status])
  @@index([userId, businessType])
  @@index([userId, nextFollowUpDate])
  @@index([userId, status, nextFollowUpDate])
  @@index([customerId, createdAt])
}

model FollowUp {
  id                 String                @id @default(cuid())
  userId             String
  customerId         String
  enquiryId          String?
  comment            String
  followUpDate       DateTime
  nextFollowUpDate   DateTime?
  status             FollowUpStatus        @default(PENDING)
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  cancellationReason String?
  lostReason         String?
  outcome            FollowUpOutcome       @default(CONTINUE)
  actionType         FollowUpActionType    @default(FOLLOW_UP)
  createdByType      FollowUpCreatedByType @default(AGENT)
  createdByStaffId   String?
  createdByName      String?
  customer           Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  enquiry            Enquiry?              @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByStaff     Staff?                @relation("FollowUpCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerId])
  @@index([enquiryId])
  @@index([createdByStaffId])
  @@index([createdByType])
  @@index([userId, status])
  @@index([userId, outcome])
  @@index([userId, followUpDate])
  @@index([userId, status, followUpDate])
  @@index([customerId, createdAt])
  @@index([enquiryId, createdAt])
}

model Policy {
  id                        String                @id @default(cuid())
  customerId                String
  policyNumber              String
  companyName               String
  productName               String?
  sumInsured                Decimal?              @db.Decimal(14, 2)
  premium                   Decimal?              @db.Decimal(14, 2)
  startDate                 DateTime?
  expiryDate                DateTime?
  policyPdfUrl              String?
  paymentType               PolicyPaymentType     @default(FULL)
  financier                 String?
  financedAmount            Decimal?              @db.Decimal(14, 2)
  emiAmount                 Decimal?              @db.Decimal(14, 2)
  emiTenure                 Int?
  firstEmiDate              DateTime?
  notes                     String?
  isActive                  Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  userId                    String
  policyType                BusinessType?
  actualPremium             Decimal?              @db.Decimal(14, 2)
  agentMargin               Decimal?              @db.Decimal(14, 2)
  agentPayable              Decimal?              @db.Decimal(14, 2)
  commissionIncome          Decimal?              @db.Decimal(14, 2)
  consultantId              String?
  continuousCoverYears      Int?
  customerDiscount          Decimal?              @db.Decimal(14, 2)
  customerPremium           Decimal?              @db.Decimal(14, 2)
  customerSource            CustomerSource        @default(SELF)
  healthBusinessType        HealthBusinessType?
  lifeProductType           LifeProductType?
  motorCoverType            MotorCoverType?
  motorOtherVehicleType     String?
  motorVehicleClass         MotorVehicleClass?
  motorVehicleSubClass      String?
  otherLifeProductName      String?
  placementSource           PolicyPlacementSource @default(SELF)
  policyStage               PolicyStage           @default(ISSUED)
  previousInsurerName       String?
  previousPolicyExpiry      DateTime?
  previousPolicyNumber      String?
  previousSumInsured        Decimal?              @db.Decimal(14, 2)
  subAgentId                String?
  vehicleIdv                Decimal?              @db.Decimal(14, 2)
  vehicleMake               String?
  vehicleModel              String?
  vehicleNcbPercent         Decimal?              @db.Decimal(6, 2)
  vehicleRegistrationNumber String?
  vehicleYear               Int?
  companyId                 String?
  originStaffId             String?
  originSupervisorId        String?
  emiFollowUps              EmiFollowUp[]
  installments              EmiInstallment[]
  company                   Company?              @relation(fields: [companyId], references: [id])
  consultant                Consultant?           @relation(fields: [consultantId], references: [id])
  customer                  Customer              @relation(fields: [customerId], references: [id])
  subAgent                  SubAgent?             @relation(fields: [subAgentId], references: [id])
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot production attribution. These do not change when assignments move later.
  originStaff      Staff? @relation("PolicyOriginStaff", fields: [originStaffId], references: [id], onDelete: SetNull)
  originSupervisor Staff? @relation("PolicyOriginSupervisor", fields: [originSupervisorId], references: [id], onDelete: SetNull)

  renewalFollowUps RenewalFollowUp[]

  @@index([userId])
  @@index([customerId])
  @@index([companyId])
  @@index([subAgentId])
  @@index([consultantId])
  @@index([originStaffId])
  @@index([originSupervisorId])
  @@index([userId, customerId])
  @@index([userId, companyId])
  @@index([userId, companyId, startDate])
  @@index([policyNumber])
  @@index([userId, policyNumber])
  @@index([expiryDate])
  @@index([userId, expiryDate])
  @@index([userId, policyType])
  @@index([userId, policyStage])
  @@index([userId, customerSource])
  @@index([userId, subAgentId])
  @@index([userId, placementSource])
  @@index([userId, consultantId])
  @@index([userId, motorVehicleClass])
  @@index([userId, motorCoverType])
  @@index([userId, healthBusinessType])
  @@index([userId, lifeProductType])
  @@index([userId, paymentType])
  @@index([userId, isActive])
  @@index([userId, isActive, expiryDate])
  @@index([userId, customerId, isActive])
}

model RenewalFollowUp {
  id               String                @id @default(cuid())
  userId           String
  customerId       String
  policyId         String
  status           RenewalFollowUpStatus @default(NOT_CONTACTED)
  followUpDate     DateTime?
  nextFollowUpDate DateTime?
  remarks          String?
  quotedPremium    Decimal?              @db.Decimal(14, 2)
  outcome          RenewalOutcome?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policy           Policy                @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@index([policyId])
  @@index([userId, status])
  @@index([userId, followUpDate])
  @@index([userId, nextFollowUpDate])
  @@index([userId, status, nextFollowUpDate])
  @@index([customerId, createdAt])
  @@index([policyId, createdAt])
}

model EmiInstallment {
  id                String        @id @default(cuid())
  policyId          String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal       @db.Decimal(14, 2)
  status            EmiStatus     @default(PENDING)
  collectedDate     DateTime?
  collectedAmount   Decimal?      @db.Decimal(14, 2)
  remarks           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  followUps         EmiFollowUp[]
  policy            Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, installmentNumber])
  @@index([policyId])
  @@index([dueDate])
  @@index([status])
  @@index([dueDate, status])
  @@index([policyId, status])
}

model EmiFollowUp {
  id               String         @id @default(cuid())
  userId           String
  customerId       String
  policyId         String
  installmentId    String
  comment          String
  followUpDate     DateTime
  nextFollowUpDate DateTime?
  status           FollowUpStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installment      EmiInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  policy           Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@index([policyId])
  @@index([installmentId])
  @@index([userId, status])
  @@index([userId, followUpDate])
  @@index([userId, status, followUpDate])
  @@index([customerId, createdAt])
  @@index([policyId, createdAt])
  @@index([installmentId, createdAt])
}

model PasswordResetOtp {
  id                  String    @id @default(cuid())
  userId              String
  otpHash             String
  expiresAt           DateTime
  attempts            Int       @default(0)
  verifiedAt          DateTime?
  usedAt              DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([resetTokenHash])
  @@index([userId, createdAt])
}

model AdminAnnouncement {
  id          String   @id @default(cuid())
  message     String
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  @@index([isActive])
  @@index([createdAt])
  @@index([createdById])
  @@index([isActive, createdAt])
}

model SupportMessage {
  id          String               @id @default(cuid())
  agentId     String
  sender      SupportMessageSender
  message     String
  adminId     String?
  readByAdmin Boolean              @default(false)
  readByAgent Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  admin       User?                @relation("SupportMessageAdmin", fields: [adminId], references: [id])
  agent       User                 @relation("SupportMessageAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([adminId])
  @@index([sender])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@index([agentId, readByAgent])
  @@index([readByAdmin])
}

model AgentCreditAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(14, 2)
  totalEarned      Decimal  @default(0) @db.Decimal(14, 2)
  totalWithdrawn   Decimal  @default(0) @db.Decimal(14, 2)
  totalPending     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id            String                @id @default(cuid())
  userId        String
  mediaId       String?
  type          CreditTransactionType
  amount        Decimal               @db.Decimal(14, 2)
  description   String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime              @default(now())
  media         Media?                @relation(fields: [mediaId], references: [id])
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mediaId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AgentBankAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  accountHolderName String
  accountNumber     String
  bankName          String
  branch            String?
  ifscCode          String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id                String           @id @default(cuid())
  agentId           String
  amount            Decimal          @db.Decimal(14, 2)
  status            WithdrawalStatus @default(PENDING)
  accountHolderName String
  accountNumber     String
  bankName          String
  branch            String?
  ifscCode          String
  requestedAt       DateTime         @default(now())
  approvedById      String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  paidAt            DateTime?
  transactionNumber String?
  paymentRemarks    String?
  paymentProofUrl   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  agent             User             @relation("AgentWithdrawals", fields: [agentId], references: [id], onDelete: Cascade)
  approvedBy        User?            @relation("WithdrawalApprovedBy", fields: [approvedById], references: [id])

  @@index([agentId])
  @@index([approvedById])
  @@index([status])
  @@index([requestedAt])
  @@index([agentId, status])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Office {
  id           String   @id @default(cuid())
  userId       String
  code         String
  name         String
  address      String?
  district     String?
  state        String?
  pincode      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  radiusMeters Int      @default(100)
  isHeadOffice Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff      Staff[]
  attendance StaffAttendance[]

  @@unique([userId, code])
  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, name])
}

model Staff {
  id                       String                     @id @default(cuid())
  userId                   String
  officeId                 String?
  staffCode                String
  name                     String
  phone                    String                     @unique
  password                 String
  whatsapp                 String?
  email                    String?
  staffRole                StaffRole                  @default(STAFF)
  designation              String?
  department               String?
  supervisorId             String?
  address                  String?
  district                 String?
  state                    String?
  pincode                  String?
  joiningDate              DateTime?
  notes                    String?
  loginEnabled             Boolean                    @default(true)
  isActive                 Boolean                    @default(true)
  inactiveReason           String?
  inactiveAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  workMode                 StaffWorkMode              @default(OFFICE)
  AttendanceRegularization AttendanceRegularization[]
  LeaveRequest             LeaveRequest[]
  supervisor               Staff?                     @relation("StaffSupervisor", fields: [supervisorId], references: [id])
  teamMembers              Staff[]                    @relation("StaffSupervisor")
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  office                   Office?                    @relation(fields: [officeId], references: [id], onDelete: SetNull)
  attendance               StaffAttendance[]
  followUpsCreated         FollowUp[]                 @relation("FollowUpCreatedByStaff")

  // Hierarchy / assignment foundation
  supervisedAgents  User[]     @relation("AgentSupervisor")
  assignedSubAgents SubAgent[] @relation("SubAgentAssignedStaff")

  subAgentAssignmentsFrom SubAgentAssignmentHistory[] @relation("SubAgentAssignmentFromStaff")
  subAgentAssignmentsTo   SubAgentAssignmentHistory[] @relation("SubAgentAssignmentToStaff")
  subAgentChangesMade     SubAgentAssignmentHistory[] @relation("SubAgentAssignmentChangedByStaff")

  enquiryOrigins           Enquiry[] @relation("EnquiryOriginStaff")
  enquirySupervisorOrigins Enquiry[] @relation("EnquiryOriginSupervisor")
  assignedEnquiries        Enquiry[] @relation("EnquiryAssignedStaff")
  supervisedEnquiries      Enquiry[] @relation("EnquiryAssignedSupervisor")

  enquiryAssignmentsFromStaff      EnquiryAssignmentHistory[] @relation("EnquiryAssignmentFromStaff")
  enquiryAssignmentsToStaff        EnquiryAssignmentHistory[] @relation("EnquiryAssignmentToStaff")
  enquiryAssignmentsFromSupervisor EnquiryAssignmentHistory[] @relation("EnquiryAssignmentFromSupervisor")
  enquiryAssignmentsToSupervisor   EnquiryAssignmentHistory[] @relation("EnquiryAssignmentToSupervisor")
  enquiryChangesMade               EnquiryAssignmentHistory[] @relation("EnquiryAssignmentChangedByStaff")

  agentSupervisorHistoryFrom AgentSupervisorHistory[] @relation("AgentSupervisorHistoryFromSupervisor")
  agentSupervisorHistoryTo   AgentSupervisorHistory[] @relation("AgentSupervisorHistoryToSupervisor")
  agentSupervisorChangesMade AgentSupervisorHistory[] @relation("AgentSupervisorHistoryChangedByStaff")

  policiesOriginated       Policy[] @relation("PolicyOriginStaff")
  policiesOriginSupervisor Policy[] @relation("PolicyOriginSupervisor")

  @@unique([userId, staffCode])
  @@index([userId])
  @@index([officeId])
  @@index([userId, officeId])
  @@index([supervisorId])
  @@index([staffRole])
  @@index([isActive])
  @@index([userId, isActive])
  @@index([userId, workMode])
  @@index([workMode])
}

model SubAgentAssignmentHistory {
  id               String              @id @default(cuid())
  subAgentId       String
  ownerUserId      String
  fromStaffId      String?
  toStaffId        String?
  changedByType    AssignmentActorType
  changedByUserId  String?
  changedByStaffId String?
